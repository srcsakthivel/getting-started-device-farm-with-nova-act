# Nova Act + Device Farm Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Nova Act Authentication ---
# Workflow Definition (recommended for production — logs to S3, team-shareable)
NOVA_ACT_WORKFLOW_DEFINITION_NAME=your-workflow-definition-name

# --- AWS Device Farm ---
# Device ARN (find available devices with: aws devicefarm list-devices --region us-west-2)
# Example (Google Pixel): arn:aws:devicefarm:us-west-2::device:876125E44C784FCD9A31D40F1E37E11F
DEVICE_FARM_DEVICE_ARN=arn:aws:devicefarm:us-west-2::device:YOUR_DEVICE_ARN_HERE

# --- Test Credentials (for Reference App login tests) ---
# These are demo credentials for the AWS Device Farm Android Reference App
LOGIN_USERNAME=admin
LOGIN_PASSWORD=password
INVALID_PASSWORD=wrongpassword
